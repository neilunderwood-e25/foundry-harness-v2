{
  "name": "@foundry/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "foundry": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@foundry/agent-runtime": "workspace:*",
    "@foundry/contracts": "workspace:*",
    "@foundry/foundation": "workspace:*",
    "@foundry/orchestrator": "workspace:*",
    "@foundry/project-inspector": "workspace:*",
    "@foundry/provider-claude": "workspace:*",
    "@foundry/provider-codex": "workspace:*"
  }
}
