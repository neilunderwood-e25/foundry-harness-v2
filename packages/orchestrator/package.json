{
  "name": "@foundry/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foundry/agent-runtime": "workspace:*",
    "@foundry/contracts": "workspace:*",
    "@foundry/domain": "workspace:*",
    "@foundry/integration": "workspace:*",
    "@foundry/input-preparation": "workspace:*",
    "@foundry/quality": "workspace:*",
    "@foundry/verifier": "workspace:*",
    "@foundry/worktrees": "workspace:*"
  },
  "devDependencies": {
    "@foundry/persistence": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
