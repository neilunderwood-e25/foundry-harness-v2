{
  "name": "@foundry/input-preparation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foundry/cms-contentful": "workspace:*",
    "@foundry/cms-contentstack": "workspace:*",
    "@foundry/cms-core": "workspace:*",
    "@foundry/contracts": "workspace:*",
    "@foundry/design": "workspace:*",
    "@foundry/input-core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
